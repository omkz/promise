{
  "_comment": [
    "Trust policy for the AgentCore Runtime execution role (attach to the role's 'Trust",
    "relationships' tab, not as a permissions policy) -- lets the bedrock-agentcore service",
    "assume the role, scoped to this account and to AgentCore resources in it. See",
    "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-permissions.html",
    "('AgentCore Runtime trust policy'). Replace <REGION>, <ACCOUNT_ID>."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeRolePolicy",
      "Effect": "Allow",
      "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "<ACCOUNT_ID>" },
        "ArnLike": { "aws:SourceArn": "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:*" }
      }
    }
  ]
}
