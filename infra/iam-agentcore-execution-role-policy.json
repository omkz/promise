{
  "_comment": [
    "AWS's own documented baseline permissions the AgentCore Runtime execution role needs to",
    "run/monitor ANY container (ECR pull, its own CloudWatch Logs group, X-Ray, the",
    "'bedrock-agentcore' CloudWatch metrics namespace, workload access tokens, and Bedrock",
    "model invocation for AgentCore's own use) -- see",
    "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-permissions.html",
    "('AgentCore Runtime execution role'), copied verbatim aside from the placeholders below.",
    "This is NOT this app's own DynamoDB/S3/Secrets Manager/Bedrock access -- attach",
    "iam-app-runtime-policy.json to the SAME role for that (the container's own code runs",
    "under this role's credentials too). Replace <REGION>, <ACCOUNT_ID>, <AGENT_NAME> (must",
    "match --agent-runtime-name on create-agent-runtime) before use."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRImageAccess",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": ["arn:aws:ecr:<REGION>:<ACCOUNT_ID>:repository/*"]
    },
    {
      "Sid": "LogGroupAccess",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:CreateLogGroup"],
      "Resource": ["arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/bedrock-agentcore/runtimes/*"]
    },
    {
      "Sid": "LogResourcePolicyAccess",
      "Effect": "Allow",
      "Action": ["logs:PutResourcePolicy"],
      "Resource": ["arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/bedrock-agentcore/runtimes/<AGENT_NAME>-*"]
    },
    {
      "Sid": "LogGroupDescribe",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": ["arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:*"]
    },
    {
      "Sid": "LogStreamWrite",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": ["arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"]
    },
    {
      "Sid": "ECRTokenAccess",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "XRayTracing",
      "Effect": "Allow",
      "Action": ["xray:PutTraceSegments", "xray:PutTelemetryRecords", "xray:GetSamplingRules", "xray:GetSamplingTargets"],
      "Resource": ["*"]
    },
    {
      "Sid": "AgentCoreMetrics",
      "Effect": "Allow",
      "Resource": "*",
      "Action": "cloudwatch:PutMetricData",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "bedrock-agentcore" } }
    },
    {
      "Sid": "GetAgentAccessToken",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetWorkloadAccessToken",
        "bedrock-agentcore:GetWorkloadAccessTokenForJWT"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:<REGION>:<ACCOUNT_ID>:workload-identity-directory/default/workload-identity/<AGENT_NAME>-*"
      ]
    },
    {
      "Sid": "BedrockModelInvocation",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": ["arn:aws:bedrock:*::foundation-model/*", "arn:aws:bedrock:<REGION>:<ACCOUNT_ID>:*"]
    }
  ]
}
