HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

STORAGE_BACKEND=local
LOCAL_DATA_DIR=../../data

AWS_REGION=us-east-1
DYNAMODB_TABLE=PROMISE
S3_BUCKET=

BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# COMMITMENT_EXTRACTION_MODEL_ID=amazon.nova-lite-v1:0   # falls back to BEDROCK_MODEL_ID if unset

PROMISE_TIMEZONE=Asia/Jakarta

# Commitment detection: below this confidence, a detected commitment is returned as
# needs_confirmation instead of being auto-captured (see POST /api/commitments).
COMMITMENT_AUTO_CAPTURE_THRESHOLD=0.80

# Default hour (0-23, in PROMISE_TIMEZONE) used to resolve a relative date that names a
# day but not a time, e.g. "tomorrow", "Friday", "next week" default to the morning hour.
PROMISE_DEFAULT_MORNING_HOUR=9
PROMISE_DEFAULT_AFTERNOON_HOUR=14
PROMISE_DEFAULT_EVENING_HOUR=18
PROMISE_DEFAULT_NIGHT_HOUR=20

# Identity & authorization: local (default) = deterministic dev identity, no JWT
# needed. oidc = every request must carry a verified Authorization: Bearer <token>
# (Amazon Cognito User Pool / any standard OIDC provider) -- see README's
# "Identity & Authorization" section.
AUTH_MODE=local
DEV_USER_ID=usr_dev_default
DEV_WORKSPACE_ID=ws_dev_default

# Only read when AUTH_MODE=oidc. COGNITO_JWKS_URL is optional -- OIDC discovery
# ({COGNITO_ISSUER}/.well-known/openid-configuration) is preferred when it's unset,
# falling back to the Cognito User Pool convention
# ({COGNITO_ISSUER}/.well-known/jwks.json) if discovery isn't reachable.
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<app-client-id>              # checked against access tokens' client_id claim
# COGNITO_AUDIENCE=<app-client-id>                # accepted alias for COGNITO_CLIENT_ID
# COGNITO_JWKS_URL=
# COGNITO_REQUIRED_SCOPES=                        # comma-separated; ALL listed scopes must be present
# COGNITO_ALLOW_ID_TOKENS=false                   # off by default -- access tokens are preferred/required

# Gmail integration (v1: search/read + send, via IntegrationRegistry.resolve_for_user --
# see the root README's "Gmail Integration" section). GMAIL_ENABLED=false (default): the
# feature doesn't exist at runtime at all, zero behavior change for anyone. Setting it to
# true requires GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET/GOOGLE_REDIRECT_URI to actually be
# set too, or /api/integrations/gmail/connect fails closed with a 503.
GMAIL_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send
# GOOGLE_OAUTH_STATE_TTL=600
# WEB_APP_URL=http://localhost:3000   # where /gmail/callback redirects back to when done

# Gmail's own documented messages.send limit: 25 MiB for the TOTAL encoded message
# (headers + body + attachment, base64url-encoded), not the attachment's own raw byte
# count -- GmailIntegrationProvider validates the literal encoded message size against
# this before ever calling Gmail. GMAIL_ATTACHMENT_ENCODING_MARGIN (default 1.35) is a
# fixed, conservative safety margin (base64's 4/3 inflation + MIME overhead) used only
# for a fast pre-check on the attachment's raw bytes, before any MIME message is built.
# GMAIL_MAX_ATTACHMENT_BYTES=26214400
# GMAIL_ATTACHMENT_ENCODING_MARGIN=1.35

# Google Calendar integration (v1: search + create, via the same IntegrationRegistry.
# resolve_for_user seam and the same GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET as Gmail above --
# see the root README's "Google Calendar Integration" section). CALENDAR_ENABLED=false
# (default): the feature doesn't exist at runtime at all. Its own redirect URI is required
# (separate from Gmail's, so connecting one never disturbs the other) --
# /api/integrations/calendar/connect fails closed with a 503 until it's set.
CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/calendar/callback
# CALENDAR_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events.owned
# CALENDAR_DEFAULT_EVENT_DURATION_MINUTES=30   # used only when a meeting commitment has no stated duration

# Where GmailIntegrationProvider's OAuth tokens are stored -- never in a normal
# application record (see IntegrationAccount.secret_ref). local (default): a file per
# secret under LOCAL_SECRETS_DIR, dev/test only. aws: AWS Secrets Manager (recommended
# whenever STORAGE_BACKEND=dynamodb).
SECRET_STORE_BACKEND=local
LOCAL_SECRETS_DIR=../../data/secrets
# SECRETS_MANAGER_PREFIX=promise/

# Where a Document's binary artifact (distinct from its extracted content_text -- see
# README's "Document storage" section) is stored. local (default): one directory per
# reference under LOCAL_DOCUMENTS_DIR, dev/test only. s3: S3_BUCKET (recommended whenever
# STORAGE_BACKEND=dynamodb) -- DynamoDB/local JSON only ever holds the storage_key pointer.
BLOB_STORE_BACKEND=local
LOCAL_DOCUMENTS_DIR=../../data/documents
# S3_DOCUMENTS_PREFIX=documents/
