HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

STORAGE_BACKEND=local
LOCAL_DATA_DIR=../../data

AWS_REGION=us-east-1
DYNAMODB_TABLE=PROMISE
S3_BUCKET=

# Shared retry config for every boto3 client this service constructs (DynamoDB, S3, Secrets
# Manager, Bedrock) -- see services/api/.env.example's own comment on this variable and
# promise_shared.aws_config.boto_config(). Only matters once a real AWS backend is in use.
AWS_MAX_RETRY_ATTEMPTS=5

BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# COMMITMENT_EXTRACTION_MODEL_ID=amazon.nova-lite-v1:0   # falls back to BEDROCK_MODEL_ID if unset

PROMISE_TIMEZONE=Asia/Jakarta

# Commitment detection: below this confidence, a detected commitment is returned as
# needs_confirmation instead of being auto-captured (see the create_commitment tool).
COMMITMENT_AUTO_CAPTURE_THRESHOLD=0.80

# Default hour (0-23, in PROMISE_TIMEZONE) used to resolve a relative date that names a
# day but not a time, e.g. "tomorrow", "Friday", "next week" default to the morning hour.
PROMISE_DEFAULT_MORNING_HOUR=9
PROMISE_DEFAULT_AFTERNOON_HOUR=14
PROMISE_DEFAULT_EVENING_HOUR=18
PROMISE_DEFAULT_NIGHT_HOUR=20

# Identity & authorization: local (default) = deterministic dev identity, no JWT
# needed. oidc = every request must carry a verified Authorization: Bearer <token>
# (Amazon Cognito User Pool / any standard OIDC provider) -- see README's
# "Identity & Authorization" section.
AUTH_MODE=local
DEV_USER_ID=usr_dev_default
DEV_WORKSPACE_ID=ws_dev_default

# Only read when AUTH_MODE=oidc. COGNITO_JWKS_URL is optional -- OIDC discovery
# ({COGNITO_ISSUER}/.well-known/openid-configuration) is preferred when it's unset,
# falling back to the Cognito User Pool convention
# ({COGNITO_ISSUER}/.well-known/jwks.json) if discovery isn't reachable.
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<app-client-id>              # checked against access tokens' client_id claim
# COGNITO_AUDIENCE=<app-client-id>                # accepted alias for COGNITO_CLIENT_ID
# COGNITO_JWKS_URL=
# COGNITO_REQUIRED_SCOPES=                        # comma-separated; ALL listed scopes must be present
# COGNITO_ALLOW_ID_TOKENS=false                   # off by default -- access tokens are preferred/required

# Gmail integration (v1) -- see services/api/.env.example for the full explanation and
# services/api for the OAuth connect/callback routes themselves (MCP has no OAuth routes
# of its own; a Gmail account connected via the REST API is picked up automatically here
# too, since both services share the same application/integration layer).
GMAIL_ENABLED=false

# Google Calendar integration (v1) -- same reasoning as Gmail above: MCP has no OAuth
# routes of its own, a Calendar account connected via the REST API is picked up
# automatically here too. See services/api/.env.example for the full variable list.
CALENDAR_ENABLED=false
SECRET_STORE_BACKEND=local
LOCAL_SECRETS_DIR=../../data/secrets

# Document binary artifacts (distinct from content_text -- see README's "Document storage"
# section). Must point at the same store as services/api so both see the same artifacts.
BLOB_STORE_BACKEND=local
LOCAL_DOCUMENTS_DIR=../../data/documents
