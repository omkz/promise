NEXT_PUBLIC_API_URL=http://localhost:8000

# local (default): deterministic dev identity, matching the API's AUTH_MODE=local.
# oidc: requests must carry a real Authorization: Bearer <token> — see
# web/lib/auth.ts and the README's "Cognito / OIDC" section (sign-in UI not
# implemented yet; this only wires the header plumbing for when it is).
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_DEV_USER_ID=usr_dev_default
NEXT_PUBLIC_DEV_WORKSPACE_ID=ws_dev_default
